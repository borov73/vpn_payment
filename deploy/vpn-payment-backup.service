[Unit]
Description=Consistent SQLite backup for VPN Payment Tracker

[Service]
Type=oneshot
User=vpnpayment
Group=vpnpayment
WorkingDirectory=/opt/vpn_payment
EnvironmentFile=/opt/vpn_payment/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash /opt/vpn_payment/deploy/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vpn-payment /var/backups/vpn-payment
RestrictAddressFamilies=AF_UNIX
