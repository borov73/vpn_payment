# Private file: never commit .env. Wallet private keys are never needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Prefer a reliable archive Base RPC for unattended monitoring.
BASE_RPC_URL=https://mainnet.base.org
DATABASE_PATH=var/vpn_payment.sqlite3
# Required: your sending wallet, 0x followed by 40 hex characters.
SENDER_ADDRESS=
# Required: all historical recipient addresses, separated by commas.
RECIPIENT_ADDRESSES=
# Required: only current recipients; must be included in the historical list.
ACTIVE_RECIPIENT_ADDRESSES=
# Required: UTC search start, no later than the first payment (example format: 2026-01-01T00:00:00Z).
HISTORY_START=
# Initial defaults for NEW databases. Existing rules are changed via CLI configure.
# Your confirmed UTC start; leave empty for a preliminary calculation.
SUBSCRIPTION_START=
MONTHLY_PRICE_EUR=4.00
PERIOD_DAYS=30
NOTIFICATIONS_ENABLED=true
# Advanced fallback only when historical nonces are unavailable:
# HISTORY_MODE=manual
# MONITOR_MODE=blocks
# Defaults: sync every 900s, reminders every 60s, 64 confirmations.
LOG_LEVEL=INFO
